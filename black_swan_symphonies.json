{
  "symphonies": {
    "black_swan_protection": {
      "name": "Integrated Black Swan Protection",
      "description": "Protect & Profit strategy with three modes: Crisis, Growth, Defense",
      "universe": ["SPY", "QQQ", "UVXY", "TLT", "GLD", "HYG", "VXX"],
      "rebalance_frequency": "daily",
      "logic": {
        "conditions": [
          {
            "id": "crisis_detection",
            "type": "if_statement",
            "condition": {
              "type": "or",
              "conditions": [
                {
                  "metric": "vix_level",
                  "asset_1": "VXX",
                  "operator": "greater_than",
                  "asset_2": {"type": "fixed_value", "value": 25},
                  "lookback_days": 1
                },
                {
                  "metric": "credit_spread",
                  "asset_1": "HYG",
                  "asset_2": "TLT",
                  "operator": "greater_than",
                  "threshold": {"type": "fixed_value", "value": 500},
                  "lookback_days": 5
                }
              ]
            },
            "if_true": "crisis_mode",
            "if_false": "growth_or_defense_check"
          },
          {
            "id": "growth_or_defense_check",
            "type": "if_statement",
            "condition": {
              "type": "and",
              "conditions": [
                {
                  "metric": "moving_average",
                  "asset_1": "SPY",
                  "operator": "greater_than",
                  "asset_2": {"type": "sma", "period": 200},
                  "lookback_days": 1
                },
                {
                  "metric": "vix_level",
                  "asset_1": "VXX",
                  "operator": "less_than",
                  "asset_2": {"type": "fixed_value", "value": 20},
                  "lookback_days": 1
                }
              ]
            },
            "if_true": "growth_mode",
            "if_false": "defense_mode"
          }
        ],
        "allocations": {
          "crisis_mode": {
            "type": "fixed_allocation",
            "weights": {
              "UVXY": 0.30,
              "TLT": 0.40,
              "GLD": 0.30
            }
          },
          "growth_mode": {
            "type": "fixed_allocation",
            "weights": {
              "SPY": 0.70,
              "QQQ": 0.25,
              "UVXY": 0.05
            }
          },
          "defense_mode": {
            "type": "fixed_allocation",
            "weights": {
              "SPY": 0.50,
              "TLT": 0.30,
              "GLD": 0.20
            }
          }
        }
      }
    },
    
